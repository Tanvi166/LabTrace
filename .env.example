# LabTrace Environment Variables Configuration

# Core Backend Config
PROJECT_NAME=LabTrace
VERSION=1.0.0
SECRET_KEY=super-secret-key-change-in-production-labtrace-2026

# Database (SQLite default for local runs)
DATABASE_URL=sqlite:///./labtrace.db
# Azure SQL uses Microsoft Entra tokens through DefaultAzureCredential (for local
# work, run `az login`). No password, token, or SQL-auth URL belongs in this file.
AZURE_SQL_ENABLED=false
AZURE_SQL_SERVER=labtrace-sql-3118.database.windows.net
AZURE_SQL_DATABASE=labtrace-db
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server
AZURE_SQL_TOKEN_SCOPE=https://database.windows.net/.default

# Storage Adapter ("local" or "azure")
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./backend/data/storage

# Azure Blob Storage (existing private account/container; never expose this container publicly).
# Use a connection string only for local development. Managed Identity/RBAC replaces
# secret-based authentication in the later security step.
AZURE_STORAGE_ACCOUNT_NAME=labtracefiles3118
# Optional override; defaults to https://labtracefiles3118.blob.core.windows.net.
AZURE_STORAGE_ACCOUNT_URL=
# Local development only. When omitted, the backend uses DefaultAzureCredential
# (for example, an authenticated Azure CLI session) against the account URL.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=research-data

# LLM Providers (Optional Cloud API Keys - Local fallback used if blank)
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Retrieval: local is functional for development; azure requires a real index.
KNOWLEDGE_PROVIDER=local
LOCAL_KNOWLEDGE_PATH=./backend/data/knowledge
EMBEDDING_DIMENSIONS=64
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_KEY=
AZURE_AI_SEARCH_INDEX_NAME=rag-1789840438987
AZURE_AI_SEARCH_VECTOR_FIELD=text_vector

# Foundry / observability (do not put these values in the frontend)
AZURE_FOUNDRY_PROJECT_ENDPOINT=
# Required only for Foundry Agent SDK calls. Format: https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_FOUNDRY_AGENT_PROJECT_ENDPOINT=
AZURE_FOUNDRY_AGENT_NAME=
AZURE_FOUNDRY_AGENT_VERSION=3
AZURE_FOUNDRY_SEARCH_CONNECTION_NAME=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_MODEL=
AZURE_FOUNDRY_DEPLOYMENT=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Azure Entra ID / Authentication (Optional)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AUTH_PROVIDER=local
